{
  "name": "plantillas-clinicas",
  "productName": "Plantillas Clínicas",
  "version": "1.1.0",
  "description": "Plantillas de exploración y tratamiento (Medicina general: Familia y Urgencias; Pediatría; Traumatología; Oftalmología) que se copian al portapapeles con un clic.",
  "author": "Íñigo Arandes Azkoiti",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "web": "node scripts/build.mjs",
    "validar": "node scripts/validar.mjs",
    "servir": "node scripts/servir.mjs",
    "iconos": "python3 scripts/generar-iconos.py",
    "windows": "node scripts/build.mjs && electron-builder --win --x64 --publish never",
    "windows:probar": "electron .",
    "android:preparar": "node scripts/build.mjs && cap sync android",
    "android": "npm run android:preparar && cd android && ./gradlew assembleRelease",
    "android:debug": "npm run android:preparar && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.6.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "es.plantillasclinicas.app",
    "productName": "Plantillas Clínicas",
    "executableName": "PlantillasClinicas",
    "copyright": "Íñigo Arandes Azkoiti",
    "directories": {
      "output": "dist/windows",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "package.json"
    ],
    "electronLanguages": [
      "es",
      "ca",
      "en-US"
    ],
    "compression": "maximum",
    "publish": null,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Plantillas Clínicas",
      "deleteAppDataOnUninstall": false,
      "artifactName": "PlantillasClinicas-${version}-instalador.${ext}"
    },
    "portable": {
      "artifactName": "PlantillasClinicas-${version}-portable.${ext}"
    }
  }
}
